# Supabase Configuration (cloud sync — optional, local-first when unset)
# Copy this file to .env and fill in your project URL + anon/public key.
# Get these from: Supabase Dashboard -> Project Settings -> API.
#
# 1. Create a project at https://supabase.com/dashboard
# 2. Open SQL Editor and run the contents of supabase/schema.sql
#    (creates tasks/subtasks/settings/profile tables with RLS, an
#    auto-updated _modified trigger, and realtime publication)
# 3. Copy this file to .env and paste the values below (no trailing slash
#    on the URL — the client appends the REST path itself)
#
# If there is no .env file, or these are empty, the app runs 100% local
# (no login UI, no sync) — that is the intended fallback.
#
# Note on email confirmation: Supabase asks users to confirm their e-mail
# when they sign up (no session is returned until they click the link).
# To let accounts activate instantly, disable Auth -> Sign In / Up ->
# "Confirm e-mail" in the dashboard.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Analytics (optional — nothing is sent when these are unset)
# PostHog: project host + key from PostHog Dashboard -> Project -> Settings.
PUBLIC_POSTHOG_HOST=
PUBLIC_POSTHOG_KEY=
# Google Analytics 4: Measurement ID (G-XXXXXXXXXX) from GA4 Admin -> Data Streams.
PUBLIC_GA4_MEASUREMENT_ID=