---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import HeroImg from '../assets/images/undraw_next-task_jtbr.svg';
import { LandingLogin } from '../components/auth/LandingLogin';
import { AuthModal } from '../components/auth/AuthModal';

const title = 'tarefitas - simplicidade para organizar rotina e tarefas';
const description =
  'Um site simples, sensorialmente amigável e offline-first para organizar rotina e tarefas diárias. Feito para mentes neurodivergentes.';
---

<Layout title={title} description={description}>
  <main class="min-h-screen bg-theme-bg flex flex-col items-center justify-center md:flex-row p-4 md:p-8">
    <section class="max-w-2xl text-left space-y-6 md:mr-12 mb-8 md:mb-0">
      <h1 class="text-3xl font-bold">
        <strong>tarefitas</strong>
      </h1>
      <h2 class="text-xl">um simples site pra organizar rotina e tarefas</h2>
      <div class="flex items-center gap-6">
        <a
          href="/app/tarefas"
          class="underline text-theme-accent hover:text-theme-accent/80 transition duration-200"
        >
          Começar
        </a>
        <LandingLogin client:load />
      </div>
    </section>
    <section>
      <Image src={HeroImg} alt="Ilustração de alguém organizando suas próximas tarefas" width={600} height={400} />
    </section>
  </main>

  <AuthModal client:load />
</Layout>
