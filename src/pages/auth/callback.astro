---
// OAuth callback handler page
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <main class="container mx-auto px-4 py-8 max-w-2xl">
    <div class="bg-white rounded-2xl p-8 shadow-sm border border-gray-100 text-center">
      <div id="auth-status" class="mb-4">
        <div class="inline-block animate-spin mb-4">
          <svg
            class="h-8 w-8 text-primary-500"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"
            />
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            />
          </svg>
        </div>
        <h2 class="heading-3 mb-2">Completing sign in...</h2>
        <p class="body text-gray-600">Please wait while we authenticate your account.</p>
      </div>
    </div>
  </main>
</Layout>

<script type="module">
  // Handle OAuth callback directly in the browser
  async function processCallback() {
    const urlParams = new URLSearchParams(window.location.search);
    const code = urlParams.get('code');
    const error = urlParams.get('error');
    
    const statusEl = document.getElementById('auth-status');
    
    if (error) {
      showError('Authentication Failed', error);
      return;
    }
    
    if (!code) {
      showError('Invalid Request', 'No authorization code received.');
      return;
    }
    
    try {
      // Get stored code verifier
      const codeVerifier = sessionStorage.getItem('oauth_code_verifier');
      if (!codeVerifier) {
        throw new Error('OAuth state not found. Please try signing in again.');
      }

      console.log('Making token exchange request...');
      
      // Call our API endpoint directly
      const response = await fetch('/api/auth/token', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
        },
        body: JSON.stringify({
          code,
          codeVerifier,
          redirectUri: window.location.origin + '/auth/callback',
        }),
      });

      console.log('API response status:', response.status);
      console.log('API response headers:', Object.fromEntries(response.headers.entries()));

      if (!response.ok) {
        const errorText = await response.text();
        console.log('Error response:', errorText);
        let errorData;
        try {
          errorData = errorText ? JSON.parse(errorText) : { error: 'Unknown error' };
        } catch (e) {
          throw new Error(`API request failed with status ${response.status}: ${errorText}`);
        }
        throw new Error(errorData.details || errorData.error || 'Authentication failed');
      }

      const responseText = await response.text();
      console.log('Success response:', responseText);
      
      const { tokens, profile } = JSON.parse(responseText);
      
      // Store tokens
      localStorage.setItem('google_access_token', tokens.access_token);
      if (tokens.refresh_token) {
        localStorage.setItem('google_refresh_token', tokens.refresh_token);
      }
      
      // Clean up session storage
      sessionStorage.removeItem('oauth_code_verifier');
      
      // Store user info for the app
      const user = {
        id: profile.sub,
        email: profile.email,
        name: profile.name,
        picture: profile.picture,
        calendarEnabled: true
      };
      localStorage.setItem('user_info', JSON.stringify(user));
      
      console.log('Authentication successful, redirecting...');
      
      // Redirect to home page after successful auth
      window.location.href = '/';
      
    } catch (err) {
      console.error('Authentication error:', err);
      showError('Authentication Error', err instanceof Error ? err.message : 'An error occurred during authentication.');
    }
  }
  
  function showError(title, message) {
    const statusEl = document.getElementById('auth-status');
    if (statusEl) {
      statusEl.innerHTML = `
        <div class="mb-4">
          <div class="text-red-500 text-4xl mb-4">⚠️</div>
          <h2 class="text-2xl font-semibold mb-2 text-red-600">${title}</h2>
          <p class="text-gray-600 mb-4">${message}</p>
          <a href="/" class="text-blue-600 hover:underline">Return to home</a>
        </div>
      `;
    }
  }
  
  // Process callback when page loads
  processCallback();
</script>
