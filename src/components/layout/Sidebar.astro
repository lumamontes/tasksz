---
/**
 * Sidebar Component (Astro)
 * Left sidebar with greeting, sections, and task filters
 * Uses React islands for interactive navigation
 */

import { SidebarNavigation } from './SidebarNavigation';
import { SidebarCollapseButton } from './SidebarCollapseButton';
import { SidebarGreeting } from './SidebarGreeting';
import { SidebarLoginCta } from './SidebarLoginCta';
import { SITE_METADATA } from '../../utils/constants';
---

<div class="h-full flex flex-col">
  <!-- Header Section -->
  <div class="p-6 border-b border-theme-border flex items-center justify-between gap-2 sidebar-header">
    <SidebarGreeting client:load />
    <SidebarCollapseButton client:load />
  </div>

  <nav class="p-6 border-b border-theme-border sidebar-nav" role="navigation" aria-label="Seções do aplicativo">
    <SidebarNavigation client:load />
  </nav>

  <!-- Blank space above the footer: login CTA / account status -->
  <div class="mt-auto px-6 py-4 flex flex-col items-center gap-2 sidebar-login-area">
    <SidebarLoginCta client:load />
  </div>

  <!-- sidebar footer -->
  <section class="p-6 border-t border-theme-border flex flex-col items-center gap-2 sidebar-footer">
    <!-- Expanded: text links -->
    <p class="sidebar-label text-sm text-theme-muted">
      fale conosco <a href={`mailto:${SITE_METADATA.contactEmail}`}  class="text-theme-accent hover:text-theme-accent/80 transition duration-200">aqui</a>
    </p>
    <div class="sidebar-label flex items-center justify-center gap-2">
      <a href={SITE_METADATA.repoUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-theme-accent hover:text-theme-accent/80 transition duration-200">
        GitHub
      </a> <span class="text-sm text-theme-muted">|</span>
      <a href={SITE_METADATA.privacyPolicyUrl} class="text-sm text-theme-accent hover:text-theme-accent/80 transition duration-200">
        Política de Privacidade
      </a>
    </div>

    <!-- Collapsed: icon-only rail links -->
    <div class="sidebar-collapsed-only flex flex-col items-center gap-3">
      <a
        href={`mailto:${SITE_METADATA.contactEmail}`}
        class="text-theme-muted hover:text-theme-accent transition duration-200"
        aria-label="Fale conosco"
        title="Fale conosco"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
      </a>
      <a
        href={SITE_METADATA.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-theme-muted hover:text-theme-accent transition duration-200"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>
      <a
        href={SITE_METADATA.privacyPolicyUrl}
        class="text-theme-muted hover:text-theme-accent transition duration-200"
        aria-label="Política de Privacidade"
        title="Política de Privacidade"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path>
        </svg>
      </a>
    </div>
  </section>
</div>
