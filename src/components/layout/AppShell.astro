---
/**
 * AppShell Layout Component (Astro)
 * Main application shell with sidebar and content area
 * Uses nanostores for state, React islands for interactivity
 */

import Sidebar from './Sidebar.astro';
import TasksArea from './TasksArea.astro';
import { SettingsPage } from '../settings/SettingsPage';
import { CelebrationHost } from '../celebration/CelebrationHost';
import { FloatingPomodoro } from '../pomodoro/FloatingPomodoro';
import { AuthModal } from '../auth/AuthModal';
import { SyncReloadNotice } from '../sync/SyncReloadNotice';
import AreasPage from '../areas/AreasPage.astro';
---

<!-- Static loading state: shown until local storage is ready. The shell
     stays inert meanwhile so its not-yet-loaded controls are unreachable. -->
<div id="app-loading" role="status" class="fixed inset-0 z-[60] flex items-center justify-center bg-theme-bg">
  <div class="text-center">
    <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-theme-panel">
      <span class="app-loading-spinner h-6 w-6 rounded-full border-2 border-theme-border border-t-theme-accent" aria-hidden="true"></span>
    </div>
    <p class="text-theme-muted">Carregando...</p>
  </div>
</div>

<div id="app-shell" inert aria-busy="true" class="flex h-screen bg-theme-bg font-sans text-theme-text overflow-hidden">
  <!-- Skip Links for Accessibility -->
  <div class="sr-only">
    <a 
      href="#main-content"
      class="focus:not-sr-only focus:absolute focus:top-4 focus:left-4 bg-theme-accent text-white px-4 py-2 rounded-lg z-50"
    >
      Pular para o conteúdo principal
    </a>
    <a 
      href="#sidebar-navigation"
      class="focus:not-sr-only focus:absolute focus:top-4 focus:left-40 bg-theme-accent text-white px-4 py-2 rounded-lg z-50"
    >
      Pular para a navegação
    </a>
  </div>

  <!-- Left Sidebar -->
  <aside 
    id="sidebar-navigation"
    class="bg-theme-sidebar border-r border-theme-border shrink-0"
    role="navigation"
    aria-label="Navegação principal"
  >
    <Sidebar />
  </aside>

  <!-- Main Panel -->
  <main 
    id="main-content"
    class="flex-1 bg-theme-panel overflow-hidden"
    role="main"
  >
    <!-- Dynamic content based on current section -->
    <div id="main-content-area" class="h-full">
      <TasksArea />
      <AreasPage />
      <!-- The shell script toggles this wrapper, never the island's own DOM,
           so hydration never sees attributes it did not render. -->
      <div data-section="configuracoes" class="h-full">
        <SettingsPage client:visible />
      </div>
    </div>
  </main>

  <!-- Task completion celebrations (hydrates on idle) -->
  <CelebrationHost client:idle />

  <!-- Detached pomodoro timer (floating, always accessible) -->
  <FloatingPomodoro client:only="react" />

  <!-- Sign-in / sign-up modal (opened from the sidebar CTA) -->
  <AuthModal client:load />
  <SyncReloadNotice client:load />
</div>

<script>
  import { initStores } from '../../utils/initStores';
  import { $currentSection, $settings, applyTheme, applyFont } from '../../stores/settingsStore';
  import { $sidebarCollapsed, loadSidebarCollapsed } from '../../stores/layoutStore';
  import { setSyncError } from '../../stores/syncStore';
  import { $persistenceReady } from '../../stores/persistence';
  
  // A falha de inicialização fica disponível para o indicador de sincronização.
  initStores().catch((error) => {
    setSyncError(error instanceof Error ? error.message : 'Não foi possível inicializar o armazenamento local.');
  });
  loadSidebarCollapsed();

  // Reveal the app once local storage is ready (also after a failed start,
  // so the sync indicator can show the error).
  $persistenceReady.subscribe((ready) => {
    if (!ready) return;
    document.getElementById('app-loading')?.remove();
    const shell = document.getElementById('app-shell');
    shell?.removeAttribute('inert');
    shell?.removeAttribute('aria-busy');
  });
  
  // Apply initial theme and font
  const settings = $settings.get();
  applyTheme(settings);
  applyFont(settings);
  
  // Apply density classes to root
  const updateDensity = () => {
    const settings = $settings.get();
    document.body.className = `density-${settings.density}`;
  };
  
  // Toggle sidebar collapsed state.
  // React islands toggle $sidebarCollapsed; this script keeps the <aside>
  // class (and thus the CSS width/rail) in sync with the store value.
  const sidebarNav = document.getElementById('sidebar-navigation');
  const updateSidebarCollapsed = () => {
    if (!sidebarNav) return;
    sidebarNav.classList.toggle('sidebar-collapsed', $sidebarCollapsed.get());
  };
  $sidebarCollapsed.subscribe(updateSidebarCollapsed);
  
  // Show/hide sections based on current section
  const updateMainContent = () => {
    const section = $currentSection.get();
    const sections = ['tasks', 'areas', 'configuracoes'];
    
    sections.forEach(sectionId => {
      const el = document.querySelector(`[data-section="${sectionId}"]`) as HTMLElement;
      if (el) {
        if (sectionId === section) {
          el.style.display = 'block';
          el.style.visibility = 'visible';
        } else {
          el.style.display = 'none';
          el.style.visibility = 'hidden';
        }
      }
    });
  };
  
  // Wait for React components to mount, then update
  const checkAndUpdate = () => {
    const hasComponents = document.querySelector('[data-section]') !== null;
    if (hasComponents) {
      updateMainContent();
    } else {
      setTimeout(checkAndUpdate, 100);
    }
  };

  // Subscribe to store changes
  $settings.subscribe(updateDensity);
  $currentSection.subscribe(updateMainContent);
  
  // Initial updates
  updateDensity();
  updateSidebarCollapsed();
  updateMainContent();
  
  // Retry only when an island has not rendered its section marker yet.
  setTimeout(checkAndUpdate, 200);
</script>

<style>
  .app-loading-spinner {
    animation: app-loading-spin 0.8s linear infinite;
  }
  @keyframes app-loading-spin {
    to { transform: rotate(360deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .app-loading-spinner { animation: none; }
  }

  /* Ensure proper layout */
  #app-shell {
    position: relative;
  }

  /* Hide sections by default, React components will handle visibility */
  [data-section] {
    height: 100%;
  }

  /* Tasks is the default route; prevent other islands from flashing before the
     client section controller applies the current section. */
</style>

<style is:global>
  [data-section="areas"],
  [data-section="configuracoes"] {
    display: none;
    visibility: hidden;
  }
</style>
